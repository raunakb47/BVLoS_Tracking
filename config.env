# ==============================================================================
# FRAMEWORK GLOBAL CONFIGURATION
# ==============================================================================
export CAPTURE_INTERFACE="wlan0mon"
export CHUNK_TIME=10

# Wi-BFI Extraction Parameters
export WIFI_CHANNEL=36              
export WIFI_STANDARD="AX"           
export MIMO_MODE="SU"               
export FALLBACK_CONFIG="2x2"        
export BANDWIDTH=80                 
export MAX_PACKETS=5000            

# Framework Thresholds
export TDT_MS=50                    # Temporal Dropout Threshold (ms)
export KE_THRESHOLD=0.02            # Kinematic Energy Occupancy Threshold (cold-start fallback, see CFAR below)
export PACKET_STARVATION_LIMIT=15   # Triggers IAA-APES if below this threshold

# OS-CFAR (3_2_Kinematic_Tracker.py) -- adaptive, per-bucket alternative to the
# single global KE_THRESHOLD above. CFAR_REFERENCE_CELLS is both the rolling
# history depth used to estimate each bucket's own noise floor and Rohling's N
# in the false-alarm-probability solve; CFAR_PFA is the target false-alarm
# probability that threshold is solved for. KE_THRESHOLD remains in force
# until a bucket has accumulated CFAR_REFERENCE_CELLS chunks of history.
export CFAR_REFERENCE_CELLS=32
export CFAR_PFA=0.001

# Cross-chunk State (state_store.py)
# Stage 3/4 run as a fresh subprocess per pcap chunk; these files are the
# on-disk handoff that survives across those invocations. Stage 3 and Stage 4
# each get their OWN state file, sharing state_store.py's bucket schema but
# never each other's data: Stage 3 owns the sliding-window/adaptive-filter
# fields, Stage 4 owns the position/track-continuity fields, and a stage
# dropping an entry it no longer needs must never delete the other stage's
# in-progress state for that same bucket.
# WINDOW_CHUNKS sets the sliding-window depth (in chunks) that KPVT/SSE
# estimate from, decoupled from CHUNK_TIME/tcpdump's rotation cadence.
# TRACK_COAST_LIMIT bounds how many consecutive chunks a client may produce
# zero BFI packets before its marker is dropped from the map instead of held
# at its last known position.
export STATE_FILE="./stage3_state.npy"
export TRACK_STATE_FILE="./stage4_track_state.npy"
export WINDOW_CHUNKS=3
export TRACK_COAST_LIMIT=3

# AP Registry (extract_ap_metadata.py + ap_registry.py)
# Persistent, cross-chunk record of each AP's SSID, advertised transmit
# power (from its own Beacon's Country/Power-Constraint elements), and a
# beacon-RSSI-derived Monitor-Card distance -- the third, independently
# measured leg of the localization triangle alongside the BFI-derived
# Client-AP bearing and the client_rssi-derived Client-MonitorCard range.
# Requires 1_Stage1_Capture.sh's capture filter to include Beacon frames
# (see CAPTURE_FILTER below); an AP whose Country element hasn't been seen
# yet falls back to tx_power_estimator.py's literature-typical default, and
# one whose Beacon hasn't been seen at all falls back to DEFAULT_AP_DISTANCE_M.
export AP_REGISTRY_PATH="./ap_registry.json"
export DEFAULT_AP_DISTANCE_M=5.0

# Optional: path to a real (oui_hex, vendor_name) CSV export for
# hotspot_classifier.py's OUI signal (see MOBILE_OUI_TABLE_PATH usage in
# 4_Stage4_Inference.py). Unset by default -- the classifier's built-in
# table is illustrative only.
export MOBILE_OUI_TABLE_PATH=""

# Directories
export WATCH_DIR="./live_chunks"
export WIBFI_DIR="../Wi-BFI"
export LOG_FILE="./pipeline.log"
export STAGE3_OUT="./stage3_telemetry.json"

# Capture filter (1_Stage1_Capture.sh): restricts capture at the kernel/BPF
# level to Beacon, Probe Response, and Action management frames -- the only
# frame types this pipeline uses (BFI Compressed Beamforming Reports are
# Action frames; AP metadata comes from Beacon/Probe Response) -- instead of
# writing every data/control frame in a busy environment to disk only to
# discard almost all of it in Stage 2's pyshark display_filter.
#
# libpcap has no named subtype keyword for Action frames (verified: "type mgt
# subtype action" fails to compile on this system's tcpdump, while beacon/
# probe-resp/etc. all compile fine as named subtypes) so Action frames are
# matched by their Frame Control byte directly: wlan[0] holds
# (subtype<<4 | type<<2 | version); masking off the low 2 (version) bits and
# comparing to 0xd0 matches type=Management(00), subtype=Action(1101),
# verified by compiling this exact expression with `tcpdump -d` before use.
# This is coarser than a byte-offset match on the exact BFI category/action
# codes specifically (Wi-BFI's own upstream 1_capture.sh does that for
# 802.11ac via "wlan[24:2] == 0x1500", i.e. Category=0x15/VHT, Action=0x00)
# because the equivalent 802.11ax/HE category byte value was not verified
# against real AX traffic in this session -- tightening this filter further
# per-standard is a safe, optional follow-up once tested against real
# hardware captures of both AC and AX beamforming reports.
export CAPTURE_FILTER="(type mgt subtype beacon) or (type mgt subtype probe-resp) or (wlan[0] & 0xfc == 0xd0)"