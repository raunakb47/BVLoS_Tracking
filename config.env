# ==============================================================================
# FRAMEWORK GLOBAL CONFIGURATION
# ==============================================================================
export CAPTURE_INTERFACE="wlan0mon"
export CHUNK_TIME=10

# Wi-BFI Extraction Parameters
export WIFI_CHANNEL=36              
export WIFI_STANDARD="AX"           
export MIMO_MODE="SU"               
export FALLBACK_CONFIG="2x2"        
export BANDWIDTH=80                 
export MAX_PACKETS=5000            

# Framework thresholds.
# TDT_MS must exceed the interval at which the AP sounds its clients or the
# sanitizer emits nothing (it reports this on stderr). Measured on the bundled
# Wi-BFI traces: ~0.1 s median gaps on 11ax, 1.5-1.9 s on 11ac. 500 suits the
# 11ax default below; an 11ac deployment needs ~2000. Size it from the capture.
# KE_THRESHOLD is only the cold start before OS-CFAR arms, and is uncalibrated:
# real chunks in testing measured KE of 0.08-1.1, well above it.
export TDT_MS=500                   # Temporal Dropout Threshold (ms)
export KE_THRESHOLD=0.02            # Kinematic Energy occupancy threshold
export PACKET_STARVATION_LIMIT=15   # routes to IAA-APES below this packet count

# OS-CFAR (3_2_Kinematic_Tracker.py): per-bucket alternative to the global
# KE_THRESHOLD above. CFAR_REFERENCE_CELLS is both the rolling history depth
# for each bucket's noise-floor estimate and Rohling's N in the false-alarm
# solve; CFAR_PFA is the target false-alarm probability. KE_THRESHOLD applies
# until a bucket has 8 chunks of history, CFAR from then on.
export CFAR_REFERENCE_CELLS=32
export CFAR_PFA=0.001

# Cross-chunk state (state_store.py). Stage 3/4 run as a fresh subprocess per
# chunk; these files carry state between invocations. Separate files by design:
# Stage 3 owns the window and filter fields, Stage 4 the track fields, and
# neither may delete the other's state for a bucket it is done with.
# WINDOW_CHUNKS is the estimation window depth in chunks; TRACK_COAST_LIMIT is
# how many consecutive empty chunks a client's marker is held for before it is
# dropped from the map.
export STATE_FILE="./stage3_state.npy"
export TRACK_STATE_FILE="./stage4_track_state.npy"
export WINDOW_CHUNKS=3
export TRACK_COAST_LIMIT=3

# AP registry (extract_ap_metadata.py + ap_registry.py): each AP's SSID,
# advertised transmit power and beacon-RSSI-derived distance, the third leg of
# the triangle alongside the BFI bearing and the client_rssi range. Needs
# Beacon frames in CAPTURE_FILTER below. An AP with no Country element seen
# falls back to tx_power_estimator's band default; one with no Beacon seen at
# all falls back to DEFAULT_AP_DISTANCE_M.
export AP_REGISTRY_PATH="./ap_registry.json"
export DEFAULT_AP_DISTANCE_M=5.0

# Log-distance path loss exponent, applied to both ranging legs. 2.0 is free
# space, the blind default. n=2 through walls OVERESTIMATES range: a source
# 10 m away in an n=3 environment reads as ~32 m. ITU-R P.1238-style indoor
# measurements report n near 2.83 @2.4GHz and 3.89 @5.3GHz; move toward those
# once the site is calibrated. No value is universally correct for an
# unsurveyed room.
export PATH_LOSS_EXPONENT=2.0

# Optional (oui_hex, vendor_name) CSV export for hotspot_classifier.py's OUI
# signal. Unset by default; the built-in table is illustrative only.
export MOBILE_OUI_TABLE_PATH=""

# Directories
export WATCH_DIR="./live_chunks"
export WIBFI_DIR="../Wi-BFI"
export LOG_FILE="./pipeline.log"
export STAGE3_OUT="./stage3_telemetry.json"

# Capture filter (1_Stage1_Capture.sh): keeps Beacon, Probe Response and Action
# management frames, the only types this pipeline reads (BFI reports are Action
# frames, AP metadata comes from Beacons), so data and control frames never
# reach disk.
#
# libpcap has no named subtype keyword for Action frames ("type mgt subtype
# action" does not compile, unlike beacon/probe-resp), so they are matched on
# the Frame Control byte: wlan[0] is (subtype<<4 | type<<2 | version), and
# masking off the version bits and comparing to 0xd0 gives type=Management,
# subtype=Action. Compiled with `tcpdump -d` before use.
#
# Coarser than matching the BFI category/action codes by offset, which Wi-BFI's
# own 1_capture.sh does for 11ac via "wlan[24:2] == 0x1500" (Category 0x15/VHT,
# Action 0x00). The 11ax/HE equivalent has not been verified against real AX
# traffic; tightening per standard is a safe follow-up once it is.
export CAPTURE_FILTER="(type mgt subtype beacon) or (type mgt subtype probe-resp) or (wlan[0] & 0xfc == 0xd0)"