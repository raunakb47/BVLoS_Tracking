# ==============================================================================
# FRAMEWORK GLOBAL CONFIGURATION
# ==============================================================================
export CAPTURE_INTERFACE="wlan0mon"
export CHUNK_TIME=10

# Directories. Stage 2 and 3 write their outputs under a per-run session
# directory created by 2_Stage2_Extraction.sh, not to fixed paths here.
export WATCH_DIR="./live_chunks"
export WIBFI_DIR="../Wi-BFI"

# Capture filter (1_Stage1_Capture.sh). Four clauses:
#
#   wlan[24:2] == 0x1500   VHT  Compressed Beamforming  (Category 0x15, Action 0x00)
#   wlan[24:2] == 0x1e00   HE   Compressed Beamforming  (Category 0x1e, Action 0x00)
#   type mgt subtype beacon
#   type mgt subtype probe-resp
#
# Reports are matched on the Action Category byte, not Frame Control. Matching
# "wlan[0] & 0xfc == 0xd0" selects subtype 13 only, and every report observed is
# subtype 14 (Action No Ack). libpcap has no named keyword for either Action
# subtype, so the category byte is the only way to select both.
#
# Offsets 24 and 25 are the frame body's first two bytes for a management frame
# with no HT Control field. A +HTC frame shifts the body to offset 28 and fails
# this test; the Order bit is clear on every report observed. capture_reader.py
# assumes the same offset.
#
# Beacons supply the only monitor-side signal measurement of an AP: reports name
# the AP only as a receiver address. They also carry SSID, BSSID and advertised
# transmit power. Probe Responses carry the same elements at a lower rate.
#
# A protected data frame can pass the wlan[24:2] clauses by coincidence, its
# CCMP packet-number bytes reading as a category. The extractor checks frame
# type and subtype before the category, so expect slightly more frames on disk
# than it reports.
#
# Compiles under tcpdump 4.99.4 / libpcap 1.10.4 against -y IEEE802_11_RADIO.
# Re-check on the capture host before the first run.
export CAPTURE_FILTER="wlan[24:2] == 0x1500 or wlan[24:2] == 0x1e00 or (type mgt subtype beacon) or (type mgt subtype probe-resp)"
