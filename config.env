# ======================================================================
# ISAC BVLoS TRACKING FRAMEWORK: GLOBAL CONFIGURATION
# ======================================================================

# --- Temporal Constraints ---
# Duration of each discrete capture window in seconds
CHUNK_TIME=5              
# Ceiling for packet processing per chunk to bound computation time
MAX_PACKETS=500           

# --- Hardware / RF Interface ---
# The network interface adapter operating in monitor mode
CAPTURE_INTERFACE="wlan0" 

# --- 802.11 Protocol Parameters ---
WIFI_STANDARD="AC"        # Protocol designation ('AC' or 'AX')
MIMO_MODE="SU"            # Spatial multiplexing mode ('SU' or 'MU')
BANDWIDTH="80"            # Channel bandwidth in MHz

# --- Extraction Failsafe ---
# Utilized ONLY if the IEEE 802.11 HE/VHT header is corrupted and the 
# extractor cannot dynamically resolve the spatial matrix dimensions.
FALLBACK_CONFIG="2x2"