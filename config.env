# ==============================================================================
# FRAMEWORK GLOBAL CONFIGURATION
# ==============================================================================
export CAPTURE_INTERFACE="wlan0mon"
export CHUNK_TIME=10

# Wi-BFI Extraction Parameters
export WIFI_CHANNEL=36              
export WIFI_STANDARD="AX"           
export MIMO_MODE="SU"               
export FALLBACK_CONFIG="2x2"        
export BANDWIDTH=80                 
export MAX_PACKETS=5000            

# Framework Thresholds
export TDT_MS=50                    # Temporal Dropout Threshold (ms)
export KE_THRESHOLD=0.02            # Kinematic Energy Occupancy Threshold
export PACKET_STARVATION_LIMIT=15   # Triggers IAA-APES if below this threshold

# Cross-chunk State (state_store.py)
# Stage 3/4 run as a fresh subprocess per pcap chunk; STATE_FILE is the on-disk
# handoff that survives across those invocations. WINDOW_CHUNKS sets the
# sliding-window depth (in chunks) that KPVT/SSE estimate from, decoupled from
# CHUNK_TIME/tcpdump's rotation cadence. TRACK_COAST_LIMIT bounds how many
# consecutive chunks a client may produce zero BFI packets before its marker
# is dropped from the map instead of held at its last known position.
export STATE_FILE="./pipeline_state.npy"
export WINDOW_CHUNKS=3
export TRACK_COAST_LIMIT=3

# Directories
export WATCH_DIR="./live_chunks"
export WIBFI_DIR="../Wi-BFI"
export LOG_FILE="./pipeline.log"
export STAGE3_OUT="./stage3_telemetry.json"